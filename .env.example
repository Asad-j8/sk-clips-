# ClipForge Environment Configuration
# Copy this file to .env and fill in your values.

# LLM Configuration
# Provider: anthropic | gemini | ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=your_llm_api_key_here

# Whisper Configuration (for transcription)
# Models: tiny, base, small, medium, large-v3
WHISPER_MODEL=small

# Processing Device (auto | cpu | cuda)
DEVICE=auto

# Face Tracking & Crop Smoothing
# Exponential Moving Average factor (0.05 to 0.3)
SMOOTHING_ALPHA=0.15

# YouTube Ingest Settings
# Optional path to user's netscape cookies.txt file
YOUTUBE_COOKIES_PATH=
# Loader.to fallback (default false/OFF)
LOADER_TO_ENABLED=false

